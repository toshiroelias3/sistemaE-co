# .env de PRODUCCIÓN para TEZAN. Copiar al servidor como .env y completar lo marcado con <...>.
# Nunca subir el .env real a git.

APP_NAME=TEZAN
APP_ENV=production
APP_KEY=                      # Generar en el servidor: php artisan key:generate
APP_DEBUG=false               # SIEMPRE false en producción (con true se exponen datos internos)
APP_URL=https://<tu-dominio>  # Ej. https://tezan.pe (sin barra final). WhatsApp e imágenes dependen de esto.

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<nombre_bd>
DB_USERNAME=<usuario_bd>
DB_PASSWORD=<clave_bd>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Correo con Gmail: crear una "contraseña de aplicación" en
# https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tezancompany@gmail.com
MAIL_PASSWORD=<contraseña-de-aplicación-de-16-letras>
MAIL_FROM_ADDRESS="tezancompany@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Datos de la tienda (config/tienda.php)
TIENDA_RAZON_SOCIAL="TEZAN S.A.C."
TIENDA_RUC=20616005163
TIENDA_DIRECCION="Av. Lima 767, Lima Centro"
TIENDA_EMAIL=tezancompany@gmail.com
TIENDA_WHATSAPP=51942817550
TIENDA_YAPE=942817550
TIENDA_YAPE_TITULAR="Eva Chanzapa Marin"
TIENDA_INSTAGRAM=
TIENDA_FACEBOOK=
TIENDA_TIKTOK=

# Plazos que se muestran al cliente (opcionales, estos son los valores por defecto)
TIENDA_HORAS_PARA_PAGAR=24
TIENDA_ENTREGA_LIMA="dentro de las 12 horas"
TIENDA_ENTREGA_PROVINCIAS="de 1 a 2 días"

# Clave del primer admin al correr el seeder. Si queda vacía se genera una al azar y se muestra una sola vez
ADMIN_INITIAL_PASSWORD=


# Mercado Pago (Checkout Pro). Vacío = la opción de tarjeta no aparece en el checkout.
# Credenciales de prueba empiezan con TEST-. Webhook: https://<dominio>/webhooks/mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
